# ============================================================
# 生产环境变量模板
# 用法：复制为 .env 后填入真实值；该文件包含密钥，切勿提交到版本库。
# ============================================================

# ---------- 数据库（必填）----------
# 服务器上建议指向本机 PostgreSQL 容器/实例。
# 若使用 Vercel Postgres Integration，可不手工填写这两项；代码会自动回退读取
# POSTGRES_PRISMA_URL / POSTGRES_URL / POSTGRES_URL_NON_POOLING。
DATABASE_URL=postgresql://rc_app:CHANGE_ME@127.0.0.1:5432/risk_control
DIRECT_DATABASE_URL=postgresql://rc_app:CHANGE_ME@127.0.0.1:5432/risk_control

# ---------- 会话签名密钥（必填）----------
# 生产环境缺失会直接启动失败（fail-closed）。
# 生成方式：openssl rand -hex 32
NEXT_RC_AUTH_SECRET=

# ---------- 内建演示账号（生产环境必须保持关闭）----------
RC_ENABLE_DEV_MOCK_ACCOUNTS=0

# ---------- 账号初始化（一次性、显式授权）----------
# 容器每次启动都会跑 seed；默认跳过账号初始化，只有显式设为 1 才执行。
# 首次部署时置 1，账号创建完成后请改回 0，避免每次重启重放初始化。
RC_ALLOW_SEED=0

# 生产环境必须为账号指定口令（JSON），长度 >= 12。系统只预置一个总管理员。
# 未列出的账号一律不创建（不会把演示账号带入生产）；其余角色由总管理员登录后自行创建。
# RC_SEED_PASSWORDS={"admin@riskcontrol.io":"<强随机口令>"}

# 仅用于重置既有账号口令时才设为 1（默认不改写已存在账号）
# RC_SEED_FORCE_PASSWORD=0

# ---------- 行情数据源 ----------
NEXT_PUBLIC_STOCK_API_KEY=

# ---------- 服务端闪跌监控 ----------
# 监控轮询间隔（秒），默认 30；监控为独立进程/容器，不依赖浏览器是否打开。
# RC_MONITOR_INTERVAL_SEC=30

# ---------- 通知通道（预警送达依赖，未配置则预警无法发出）----------
NOTIFICATION_SEND_TOKEN=
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
