# ===== 鉴权（生产必填）=====
# 会话签名密钥。生产环境缺失将导致登录全部不可用（fail-closed）。
# 生成命令：openssl rand -hex 32
NEXT_RC_AUTH_SECRET=

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://user:password@localhost:5432/risk_control

# Stock API (Yahoo Finance / Finnhub)
NEXT_PUBLIC_STOCK_API_KEY=your-stock-api-key

# ============================================================
# 通知通道：每个渠道选择一种服务。服务端 Webhook 优先于官方 API。
# 设置页 Webhook 留空即可；如填写，必须与服务端地址完全一致。
# ============================================================
# 可选：旧服务端集成使用，网页发送由管理员／风控总监的登录权限控制。
# 无需在网页中粘贴授权码。
NOTIFICATION_SEND_TOKEN=

# --- 通用自定义 Webhook（Make / n8n / Zapier / 自建 HTTP 接收端）---
# 如果填了这两项，会优先 POST 到你指定的 URL；
EMAIL_WEBHOOK_URL=your-email-webhook

# --- 方案 A：邮件走 Resend（推荐，免费额度充足）---
# 官网 https://resend.com → 获取 API Key，发件地址域名必须在 Resend 后台已验证
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_FROM_EMAIL="RiskControl <noreply@your-domain.com>"

# --- 方案 B：邮件走 Postmark ---
# POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- 方案 C：邮件走 SendGrid ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx


# Set a currently supported version from your Meta app dashboard.

# Telegram 风控频道（只发布到频道，不使用私聊订阅）
TELEGRAM_BOT_TOKEN=
# 可选：填写后由环境变量固定频道；否则管理员可在系统设置中验证并保存
# 支持 @channel_username 或 -100 开头的频道 ID
TELEGRAM_CHANNEL_ID=
# 私有频道可设置邀请链接；公开频道可自动生成加入链接
TELEGRAM_CHANNEL_URL=

# 每日加密逻辑备份（与登录密钥独立；请单独离线备存，否则无法解密恢复）
BACKUP_KEY=

# Vercel 每日定时任务鉴权（独立随机值）
CRON_SECRET=
