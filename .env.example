NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://user:password@localhost:5432/risk_control

# Stock API (Yahoo Finance / Finnhub)
NEXT_PUBLIC_STOCK_API_KEY=your-stock-api-key

# ============================================================
# 通知通道（真实打通三选一即可，优先级：设置页 Webhook 输入 > 下方环境变量）
# ============================================================

# --- 通用自定义 Webhook（Make / n8n / Zapier / 自建 HTTP 接收端）---
# 如果填了这两项，会优先 POST 到你指定的 URL；
# 不填的话，下面的 Resend / Twilio / Meta 也可直接走官方 API（更推荐）
EMAIL_WEBHOOK_URL=your-email-webhook
WHATSAPP_WEBHOOK_URL=your-whatsapp-webhook

# --- 方案 A：邮件走 Resend（推荐，免费额度充足）---
# 官网 https://resend.com → 获取 API Key，发件地址域名必须在 Resend 后台已验证
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_FROM_EMAIL="RiskControl <noreply@your-domain.com>"

# --- 方案 B：邮件走 Postmark ---
# POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- 方案 C：邮件走 SendGrid ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx

# --- 方案 1：WhatsApp 走 Twilio（推荐，含 sandbox 可先测试）---
# Twilio Console → 获取 ACCOUNT_SID / AUTH_TOKEN；From 号码如果是 WhatsApp sandbox 须填 "whatsapp:+14155238886"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM_NUMBER="whatsapp:+14155238886"
# 如果只是走普通短信（非 WA），填下面这条
# TWILIO_FROM_NUMBER="+1234567890"

# --- 方案 2：WhatsApp 走 Meta (Facebook) Graph API（官方 Cloud API）---
# 开发者后台 → WhatsApp → 取永久 Token + 手机号 ID
# META_WA_ACCESS_TOKEN=EAAC...
# META_WA_PHONE_NUMBER_ID=1234567890
