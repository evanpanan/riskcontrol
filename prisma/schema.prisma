generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum BatchStatus {
  LOCKED
  TRADING_OPEN
  CLOSED
  LIQUIDATED
}

enum RiskLevel {
  NORMAL
  WARNING
  CRITICAL
}

enum ClientStatus {
  ACTIVE
  EXIT_REQUESTED
  SETTLED
}

enum MarginCallStatus {
  PENDING
  FULLFILLED
  EXPIRED
  CANCELLED
  OVERDUE
}

enum AppRole {
  ADMIN
  RISK_MANAGER
  BD_MANAGER
  OPERATIONS
}

model AppUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  passwordSalt       String?
  displayName        String
  role               AppRole
  avatarInitials     String
  avatarDataUrl      String?
  bdManagerFullName  String?  @unique
  enabled            Boolean  @default(true)
  isPrimaryAdmin     Boolean  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  clients            Client[] @relation("BdToClients")
  sessions           Session[]

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  token      String   @unique
  ipAddr     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Batch {
  id                String          @id @default(cuid())
  batchNumber       String          @unique
  stockSymbol       String
  stockName         String?
  stockPriceAtStart Float
  currentStockPrice Float?
  currentDayChange  Float?          @default(0)
  initialTotalAmount Float
  priorityAmount    Float
  subordinateAmount Float
  signDate          DateTime
  maturityDate      DateTime
  totalShares       Float
  currentMarketValue Float?
  totalPnL          Float?          @default(0)
  totalPnLPercent   Float?          @default(0)
  cumulativeMarginCalls Float        @default(0)
  status            BatchStatus     @default(LOCKED)
  riskLevel         RiskLevel       @default(NORMAL)
  nextTradingWindow DateTime?
  // --- 协议要素表 V2 新增字段 ---
  custodianBroker   String          @default("中阳证券有限公司")
  lockUpEndDate     DateTime?       // 封闭期满日（签约后 6 个月）
  exitWindowMonths  Int             @default(3)  // 开放退出窗口周期（每 3 个月）
  noticePeriodDays  Int             @default(15) // 退出提前通知天数
  finalMaturityDate DateTime?       // 最终到期日（签约后 2 年）
  win100CollateralValue Float       @default(0)  // WIN100 履约担保品市值
  win100CollateralShares Float      @default(0)  // WIN100 担保持股数
  // --- end ---
  clients           Client[]
  marginCalls       MarginCall[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([riskLevel])
  @@index([signDate])
}

model Client {
  id              String       @id @default(cuid())
  clientNo        String?      @unique
  batchId         String
  name            String
  investmentAmount Float
  bdManager       String
  bdUserId        String?
  bdUser          AppUser?     @relation("BdToClients", fields: [bdUserId], references: [id])
  signDate        DateTime
  profitSplitClient Float
  profitSplitInstitution Float
  realtimePnL     Float?       @default(0)
  estimatedExitAmount Float?
  status          ClientStatus @default(ACTIVE)
  settledAt       DateTime?
  settlementNote  String?
  // --- 协议要素表 V2 新增字段 ---
  sharesHeld      Float        @default(0)  // 客户持股数（自己中阳账户）
  avgCostPrice    Float        @default(0)  // 平均成本价
  brokerAccount   String?                   // 中阳证券账号
  // --- Phase 3: 客户退出全流程 ---
  exitRequestedAt DateTime?                 // 退出申请时间
  exitEligibleAt  DateTime?                 // 退出资格时间（申请 + 通知期）
  earlyExitFee    Float?                    // 提前退出手续费金额（本金 × 1%）
  exitAmount      Float?                    // 退出金额（扣除手续费后客户实收）
  // --- Phase 4: 客户多批次子账户 ---
  subAccountNo    String?   @unique         // 中阳证券子账号编号（客户×批次唯一）
  // --- end ---
  batch           Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([batchId])
  @@index([bdManager])
  @@index([status])
  @@index([bdUserId])
  @@index([clientNo])
}

model MarginCall {
  id              String          @id @default(cuid())
  batchId         String
  triggerDate     DateTime
  triggerMarketValue Float
  dropPercent     Float
  requiredAmount  Float
  fulfilledAmount Float?
  fulfilledDate   DateTime?
  status          MarginCallStatus @default(PENDING)
  note            String?
  dueDate         DateTime?
  collateralType  String?
  notifiedEmails  String?
  notifiedWhatsApps String?
  batch           Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@index([batchId])
  @@index([status])
}

model StockHistory {
  id         String   @id @default(cuid())
  symbol     String   @unique
  name       String?
  usageCount Int      @default(1)
  lastUsed   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([usageCount])
  @@index([lastUsed])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  role       String?
  action     String
  resource   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

enum NotificationStatus {
  SENT
  PARTIAL
  FAILED
}

// 通知投递记录：预警发送成功/部分/失败均落库，便于失败追溯与补发
// WhatsApp 订阅者：用户向机器人号发送任意消息即订阅，发"退订"则取消。
// 风控事件触发 WhatsApp 推送时，系统自动把本表里所有 active 的号码并入收件人。
model WhatsAppSubscriber {
  id             String   @id @default(cuid())
  phone          String   @unique
  displayName    String?
  source         String?
  active         Boolean  @default(true)
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
  @@index([lastMessageAt])
}

model NotificationLog {
  id         String             @id @default(cuid())
  channel    String
  provider   String?
  title      String
  recipients String
  status     NotificationStatus
  error      String?
  batchId    String?
  type       String?
  createdAt  DateTime           @default(now())

  @@index([createdAt])
  @@index([status])
}

// 业务工作区记录：批次/客户/补仓/结算等运行态数据的服务端唯一事实来源。
// 以 (kind, key) 复合主键承载多端共享的工作区状态，revision 用于乐观锁并发控制。
//   kind: ledger（批次资金账本快照）| patches（补仓补丁）| client_status（客户状态覆盖）| meta（工作区元信息）
//   key : 批次 ID / 客户 ID / 单例键
model WorkspaceRecord {
  kind      String
  key       String
  payload   Json
  revision  Int      @default(0)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([kind, key])
  @@index([kind])
  @@index([updatedAt])
}

// 资金操作幂等登记：每次资金提交携带客户端生成的 opId。
// 与账本写入、审计记录在同一事务内提交；重放同一 opId 不再重复记账。
model FinanceCommit {
  opId      String   @id
  actorId   String?
  kind      String
  key       String
  revision  Int
  /// 请求内容摘要（操作人 + 业务对象 + 操作类型 + 规范化请求内容）：同键不同内容视为冲突。
  digest    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([key])
}

// 登录限流：进程内 Map 在多实例部署时各算各的，无法拦住分布式撞库。
// 落库后所有实例共享同一份计数窗口。
model AuthThrottle {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// 服务端行情采集点：闪跌监控必须独立于浏览器持续运行，
// 因此价格历史落库，浏览器关闭期间仍可连续检测。
model QuotePricePoint {
  id        String   @id @default(cuid())
  batchId   String
  symbol    String
  price     Float
  source    String
  asOf      DateTime
  createdAt DateTime @default(now())

  @@index([batchId, asOf])
  @@index([createdAt])
}

// 历史 K 线缓存：同一 symbol + interval + candleTime 只保留一条，
// 已经抓过的历史 candle 落库后优先复用，减少每次都向外部行情源重拉整段历史。
model QuoteHistoryCandle {
  id         String   @id @default(cuid())
  symbol     String
  interval   String
  candleTime DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float    @default(0)
  provider   String
  fetchedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([symbol, interval, candleTime])
  @@index([symbol, interval, candleTime])
  @@index([fetchedAt])
}

// 首页大盘曲线真实快照：按 scope（全局 / 商务经理）和整点 bucket 落库，
// 供资产价值曲线与收益率曲线直接读取历史业务结果，避免长期依赖前端合成走势。
model DashboardSnapshot {
  id                  String   @id @default(cuid())
  scopeType           String
  scopeKey            String
  bucketAt            DateTime
  totalValue          Float
  institutionValue    Float
  clientValue         Float
  totalYieldPct       Float
  institutionYieldPct Float
  clientYieldPct      Float
  totalPnL            Float    @default(0)
  institutionPnL      Float    @default(0)
  clientPnL           Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([scopeType, scopeKey, bucketAt])
  @@index([scopeType, scopeKey, bucketAt])
}

// 闪跌告警：dedupeKey 保证同一批次同一阈值在冷却期内只告警一次，
// delivered 记录实际送达结果，失败可由下一轮重试。
model FlashCrashAlert {
  id                String   @id @default(cuid())
  batchId           String
  symbol            String
  windowMinutes     Int
  dropPercent       Float
  actualDropPercent Float
  highPrice         Float
  currentPrice      Float
  dedupeKey         String   @unique
  delivered         Boolean  @default(false)
  deliveryNote      String?
  sentChannels      String[] @default([])
  nextAttemptAt     DateTime @default(now())
  deliveryLeaseUntil DateTime?
  deliveryLeaseToken String?
  createdAt         DateTime @default(now())

  @@index([batchId, createdAt])
  @@index([delivered])
  @@index([delivered, nextAttemptAt])
}

model NotificationDispatch {
  id String @id @default(cuid())
  identity String
  payload Json
  policy Json
  state Json
  status String @default("PENDING")
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  reviewedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identity, updatedAt])
  @@index([status, nextAttemptAt])
}

// 收盘后留存的批次业务快照；不会用今日持仓倒推旧日收益。
model BatchDailySnapshot {
  id String @id @default(cuid())
  batchId String
  tradingDate String
  capturedAt DateTime @default(now())
  source String
  summary Json
  ledger Json
  @@unique([batchId, tradingDate])
  @@index([tradingDate])
}

// 每日完整逻辑备份：压缩后 AES-256-GCM 加密。密钥仅由服务器环境提供。
model BackupArchive {
  id String @id @default(cuid())
  backupDate String @unique
  capturedAt DateTime @default(now())
  data Bytes
  sha256 String
  byteLength Int
  emailState Json
  emailStatus String @default("PENDING")
  leaseToken String?
  leaseUntil DateTime?
  lastError String?
}
