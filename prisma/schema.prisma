generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum BatchStatus {
  LOCKED
  TRADING_OPEN
  CLOSED
  LIQUIDATED
}

enum RiskLevel {
  NORMAL
  WARNING
  CRITICAL
}

enum ClientStatus {
  ACTIVE
  EXIT_REQUESTED
  SETTLED
}

enum MarginCallStatus {
  PENDING
  FULLFILLED
  EXPIRED
  CANCELLED
  OVERDUE
}

enum AppRole {
  ADMIN
  RISK_MANAGER
  BD_MANAGER
  OPERATIONS
}

model AppUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  enabled            Boolean  @default(true)
  avatarDataUrl      String?
  displayName        String
  role               AppRole
  avatarInitials     String
  bdManagerFullName  String?  @unique
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  clients            Client[] @relation("BdToClients")
  sessions           Session[]

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  token      String   @unique
  ipAddr     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Batch {
  id                String          @id @default(cuid())
  batchNumber       String          @unique
  stockSymbol       String
  stockName         String?
  stockPriceAtStart Float
  currentStockPrice Float?
  currentDayChange  Float?          @default(0)
  initialTotalAmount Float
  priorityAmount    Float
  subordinateAmount Float
  signDate          DateTime
  maturityDate      DateTime
  totalShares       Float
  currentMarketValue Float?
  totalPnL          Float?          @default(0)
  totalPnLPercent   Float?          @default(0)
  cumulativeMarginCalls Float        @default(0)
  status            BatchStatus     @default(LOCKED)
  riskLevel         RiskLevel       @default(NORMAL)
  nextTradingWindow DateTime?
  // --- 协议要素表 V2 新增字段 ---
  custodianBroker   String          @default("中阳证券有限公司")
  lockUpEndDate     DateTime?       // 封闭期满日（签约后 6 个月）
  exitWindowMonths  Int             @default(3)  // 开放退出窗口周期（每 3 个月）
  noticePeriodDays  Int             @default(15) // 退出提前通知天数
  finalMaturityDate DateTime?       // 最终到期日（签约后 2 年）
  win100CollateralValue Float       @default(0)  // WIN100 履约担保品市值
  win100CollateralShares Float      @default(0)  // WIN100 担保持股数
  // --- end ---
  clients           Client[]
  marginCalls       MarginCall[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([riskLevel])
  @@index([signDate])
}

model Client {
  id              String       @id @default(cuid())
  clientNo        String?      @unique
  batchId         String
  name            String
  investmentAmount Float
  bdManager       String
  bdUserId        String?
  bdUser          AppUser?     @relation("BdToClients", fields: [bdUserId], references: [id])
  signDate        DateTime
  profitSplitClient Float
  profitSplitInstitution Float
  realtimePnL     Float?       @default(0)
  estimatedExitAmount Float?
  status          ClientStatus @default(ACTIVE)
  settledAt       DateTime?
  settlementNote  String?
  // --- 协议要素表 V2 新增字段 ---
  sharesHeld      Float        @default(0)  // 客户持股数（自己中阳账户）
  avgCostPrice    Float        @default(0)  // 平均成本价
  brokerAccount   String?                   // 中阳证券账号
  // --- Phase 3: 客户退出全流程 ---
  exitRequestedAt DateTime?                 // 退出申请时间
  exitEligibleAt  DateTime?                 // 退出资格时间（申请 + 通知期）
  earlyExitFee    Float?                    // 提前退出手续费金额（本金 × 1%）
  exitAmount      Float?                    // 退出金额（扣除手续费后客户实收）
  // --- Phase 4: 客户多批次子账户 ---
  subAccountNo    String?   @unique         // 中阳证券子账号编号（客户×批次唯一）
  // --- end ---
  batch           Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([batchId])
  @@index([bdManager])
  @@index([status])
  @@index([bdUserId])
  @@index([clientNo])
}

model MarginCall {
  id              String          @id @default(cuid())
  batchId         String
  triggerDate     DateTime
  triggerMarketValue Float
  dropPercent     Float
  requiredAmount  Float
  fulfilledAmount Float?
  fulfilledDate   DateTime?
  status          MarginCallStatus @default(PENDING)
  note            String?
  dueDate         DateTime?
  collateralType  String?
  notifiedEmails  String?
  notifiedWhatsApps String?
  batch           Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@index([batchId])
  @@index([status])
}

model StockHistory {
  id         String   @id @default(cuid())
  symbol     String   @unique
  name       String?
  usageCount Int      @default(1)
  lastUsed   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([usageCount])
  @@index([lastUsed])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  role       String?
  action     String
  resource   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// Authoritative financial snapshots. Updated only by server commands under revision CAS.
model LedgerBatch {
  id        String   @id
  revision  Int      @default(0)
  snapshot  Json
  batchNumber String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LedgerCommand {
  id        String   @id
  actorId   String
  requestHash String @default("")
  batchId   String
  result    Json
  createdAt DateTime @default(now())
  @@index([batchId])
}

model AppConfig {
  id String @id
  value Json
  updatedAt DateTime @updatedAt
}

// One actual last-observed valuation per UTC hour. No backfilled synthetic history.
model LedgerValuation {
  id String @id
  batchId String
  bucketAt DateTime
  recordedAt DateTime
  metrics Json
  @@index([bucketAt])
  @@index([batchId, bucketAt])
}

model OperationalLease {
  id String @id
  token String
  expiresAt DateTime
}

model MonitorRun {
  id String @id
  startedAt DateTime @default(now())
  completedAt DateTime?
  status String
  detail Json?
  @@index([startedAt])
}

model RiskNotification {
  id String @id
  batchId String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  error String?
  @@index([status, createdAt])
}
